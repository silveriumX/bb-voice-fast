@@ -0,0 +1,199 @@
+// @vitest-environment jsdom
+
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { afterEach, beforeEach, expect, it, vi } from "vitest";
+import { useVoiceInput } from "./useVoiceInput";
+
+const live = vi.hoisted(() => ({
+  finish: vi.fn(),
+  push: vi.fn(),
+  abort: vi.fn(),
+  onText: null as null | ((text: string) => void),
+  timings: [] as Record<string, unknown>[],
+}));
+
+vi.mock("@/components/ui/app-toast", () => ({ appToast: { error: vi.fn() } }));
+vi.mock("@/lib/save-file", () => ({ saveFile: vi.fn() }));
+vi.mock("@/lib/audio-input-device-preference", () => ({
+  useAudioInputDevicePreferenceValue: vi.fn(() => null),
+  requestAudioInputStream: (mediaDevices: MediaDevices) =>
+    mediaDevices.getUserMedia({ audio: true }),
+}));
+vi.mock("@/lib/microphone-recording-stream", () => ({
+  createMicrophoneRecordingStream: (input: MediaStream) => ({
+    stream: input,
+    resume: async () => {},
+    tapPcm: (onSamples: (samples: Float32Array, rate: number) => void) => {
+      onSamples(new Float32Array(4096), 48_000);
+      return true;
+    },
+    replace: vi.fn(),
+    close: vi.fn(),
+  }),
+}));
+vi.mock("@/lib/voice-live", () => ({
+  isLiveVoiceEnabled: () => true,
+  reportVoiceTiming: (timing: Record<string, unknown>) =>
+    live.timings.push(timing),
+  startLiveTranscription: (options: { onText: (text: string) => void }) => {
+    live.onText = options.onText;
+    return { push: live.push, finish: live.finish, abort: live.abort };
+  },
+}));
+
+class Recorder {
+  static isTypeSupported = () => true;
+  mimeType = "audio/webm";
+  state = "inactive";
+  onstart = () => {};
+  ondataavailable = (_event: { data: Blob }) => {};
+  onstop = async () => {};
+  start() {
+    this.state = "recording";
+    this.onstart();
+  }
+  stop() {
+    this.state = "inactive";
+    this.ondataavailable({ data: new Blob(["recorded audio"]) });
+    return this.onstop();
+  }
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.stubGlobal("MediaRecorder", Recorder);
+  const node = () => ({
+    connect: vi.fn(),
+    disconnect: vi.fn(),
+    getByteTimeDomainData: vi.fn(),
+    getFloatTimeDomainData: vi.fn(),
+    fftSize: 2048,
+  });
+  vi.stubGlobal(
+    "AudioContext",
+    class {
+      state = "running";
+      sampleRate = 48_000;
+      createAnalyser = node;
+      createMediaStreamSource = node;
+      resume = async () => {};
+      close = async () => {};
+    },
+  );
+  vi.stubGlobal("navigator", {
+    mediaDevices: {
+      getUserMedia: vi.fn().mockResolvedValue({
+        getTracks: () => [{ stop: vi.fn() }],
+        getAudioTracks: () => [],
+      }),
+    },
+  });
+  live.timings = [];
+});
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+  vi.clearAllMocks();
+});
+
+it("shows words while speaking and inserts the live text without a batch upload", async () => {
+  live.finish.mockResolvedValue({
+    ok: true,
+    text: "Оплатить 43 500 рублей",
+    model: "scribe_v3_live",
+  });
+  const onTranscribe = vi.fn();
+  const onTranscript = vi.fn();
+  const { result } = renderHook(() =>
+    useVoiceInput({ recordingKey: "thread/live", onTranscribe, onTranscript }),
+  );
+  await act(() => result.current.start());
+  expect(live.push).toHaveBeenCalled();
+  act(() => live.onText?.("Оплатить 43"));
+  expect(result.current.liveText).toBe("Оплатить 43");
+  vi.advanceTimersByTime(1500);
+  await act(async () => result.current.stop("send"));
+  await act(() => vi.advanceTimersByTimeAsync(10));
+  expect(onTranscribe).not.toHaveBeenCalled();
+  expect(onTranscript).toHaveBeenCalledExactlyOnceWith(
+    "Оплатить 43 500 рублей",
+    "send",
+  );
+  expect(result.current.liveText).toBe("");
+  expect(result.current.failedRecordings).toEqual([]);
+  expect(live.timings[0]).toMatchObject({
+    path: "live",
+    model: "scribe_v3_live",
+    outcome: "transcript",
+  });
+});
+
+it("falls back to the saved recording when live transcription fails", async () => {
+  live.finish.mockResolvedValue({ ok: false, reason: "socket error" });
+  const onTranscribe = vi.fn().mockResolvedValue("Из записи");
+  const onTranscript = vi.fn();
+  const { result } = renderHook(() =>
+    useVoiceInput({
+      recordingKey: "thread/live-fallback",
+      onTranscribe,
+      onTranscript,
+    }),
+  );
+  await act(() => result.current.start());
+  vi.advanceTimersByTime(1500);
+  await act(async () => result.current.stop("insert"));
+  await act(() => vi.advanceTimersByTimeAsync(10));
+  expect(onTranscribe).toHaveBeenCalledOnce();
+  expect(onTranscript).toHaveBeenCalledExactlyOnceWith("Из записи", "insert");
+  expect(live.timings[0]).toMatchObject({
+    path: "batch",
+    liveFailure: "socket error",
+  });
+});
+
+it("keeps the finished text when inserting it fails, and inserts it later without transcribing again", async () => {
+  live.finish.mockResolvedValue({ ok: true, text: "Готовый текст", model: "m" });
+  const onTranscribe = vi.fn();
+  const onTranscript = vi
+    .fn()
+    .mockRejectedValueOnce(new Error("composer gone"))
+    .mockResolvedValueOnce(undefined);
+  const { result } = renderHook(() =>
+    useVoiceInput({
+      recordingKey: "thread/live-insert-failed",
+      onTranscribe,
+      onTranscript,
+    }),
+  );
+  await act(() => result.current.start());
+  vi.advanceTimersByTime(1500);
+  await act(async () => result.current.stop("insert"));
+  await act(() => vi.advanceTimersByTimeAsync(10));
+  const [saved] = result.current.failedRecordings;
+  expect(saved).toMatchObject({
+    transcript: "Готовый текст",
+    errorMessage: "Текст готов — нажмите «Вставить»",
+  });
+  if (!saved) throw new Error("missing saved text");
+  await act(async () => result.current.retry(saved));
+  await act(() => vi.advanceTimersByTimeAsync(10));
+  expect(onTranscribe).not.toHaveBeenCalled();
+  expect(onTranscript).toHaveBeenLastCalledWith("Готовый текст", "insert");
+  expect(result.current.failedRecordings).toEqual([]);
+});
+
+it("stops live transcription when the user cancels the recording", async () => {
+  const { result } = renderHook(() =>
+    useVoiceInput({
+      recordingKey: "thread/live-cancel",
+      onTranscribe: vi.fn(),
+      onTranscript: vi.fn(),
+    }),
+  );
+  await act(() => result.current.start());
+  await act(async () => result.current.cancel());
+  expect(live.abort).toHaveBeenCalled();
+  expect(live.finish).not.toHaveBeenCalled();
+});
