@@ -0,0 +1,338 @@
+import { appSurfaceRequestInit } from "@/lib/app-surface";
+
+const LIVE_PLUGIN_ID = "voice-fast";
+const LIVE_TOKEN_PATH = `/api/v1/plugins/${LIVE_PLUGIN_ID}/http/live-token`;
+const LIVE_TIMING_PATH = `/api/v1/plugins/${LIVE_PLUGIN_ID}/http/timing`;
+const LIVE_SOCKET_URL = "wss://api.elevenlabs.io/v1/speech-to-text/realtime";
+const LIVE_SAMPLE_RATE = 16_000;
+const LIVE_SEND_SAMPLES = 1_600;
+const LIVE_MAX_BUFFERED_SAMPLES = LIVE_SAMPLE_RATE * 30;
+const LIVE_DISABLED_STORAGE_KEY = "bb-voice-live-disabled";
+const LIVE_PAUSE_COMMIT_SILENCE_SAMPLES = Math.round(LIVE_SAMPLE_RATE * 0.7);
+const LIVE_PAUSE_COMMIT_MIN_SAMPLES = LIVE_SAMPLE_RATE * 10;
+const LIVE_SILENCE_RMS = 0.012;
+
+export interface LiveTranscription {
+  push(samples: Float32Array, sampleRate: number): void;
+  finish(timeoutMs: number): Promise<LiveResult>;
+  abort(): void;
+}
+
+export type LiveResult =
+  | { ok: true; text: string; model: string }
+  | { ok: false; reason: string };
+
+interface TokenResponse {
+  ok: boolean;
+  token?: string;
+  models?: string[];
+  language?: string;
+}
+
+export function isLiveVoiceEnabled(): boolean {
+  if (typeof window === "undefined" || typeof WebSocket === "undefined") {
+    return false;
+  }
+  try {
+    return window.localStorage.getItem(LIVE_DISABLED_STORAGE_KEY) !== "1";
+  } catch {
+    return true;
+  }
+}
+
+export function reportVoiceTiming(
+  timing: Record<string, string | number | boolean>,
+): void {
+  if (typeof fetch === "undefined") return;
+  void fetch(
+    LIVE_TIMING_PATH,
+    appSurfaceRequestInit({
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify(timing),
+      keepalive: true,
+    }),
+  ).catch(() => {});
+}
+
+function downsample(input: Float32Array, inputRate: number): Int16Array {
+  const ratio = inputRate / LIVE_SAMPLE_RATE;
+  const length = Math.floor(input.length / ratio);
+  const output = new Int16Array(length);
+  for (let index = 0; index < length; index += 1) {
+    const start = Math.floor(index * ratio);
+    const end = Math.min(input.length, Math.floor((index + 1) * ratio));
+    let sum = 0;
+    for (let cursor = start; cursor < end; cursor += 1) sum += input[cursor]!;
+    const value = end > start ? sum / (end - start) : 0;
+    const clamped = Math.max(-1, Math.min(1, value));
+    output[index] = clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff;
+  }
+  return output;
+}
+
+function toBase64(samples: Int16Array): string {
+  const bytes = new Uint8Array(
+    samples.buffer,
+    samples.byteOffset,
+    samples.byteLength,
+  );
+  let binary = "";
+  for (let index = 0; index < bytes.length; index += 0x8000) {
+    binary += String.fromCharCode(...bytes.subarray(index, index + 0x8000));
+  }
+  return btoa(binary);
+}
+
+async function fetchToken(signal: AbortSignal): Promise<TokenResponse> {
+  const response = await fetch(
+    LIVE_TOKEN_PATH,
+    appSurfaceRequestInit({
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: "{}",
+      signal,
+    }),
+  );
+  if (!response.ok) throw new Error(`token HTTP ${response.status}`);
+  const body = (await response.json()) as TokenResponse;
+  if (!body.ok || typeof body.token !== "string") throw new Error("no token");
+  return body;
+}
+
+export function startLiveTranscription(options: {
+  onText: (text: string) => void;
+}): LiveTranscription {
+  const controller = new AbortController();
+  let socket = null as WebSocket | null;
+  let model = "";
+  let pending: Int16Array[] = [];
+  let pendingSamples = 0;
+  let outbox: Int16Array[] = [];
+  let outboxSamples = 0;
+  let committed = "";
+  let commitsSent = 0;
+  let commitsReceived = 0;
+  let silentSamples = 0;
+  let samplesSinceCommit = 0;
+  let partial = "";
+  let failure: string | null = null;
+  let finishing = false;
+  let settleFinish: (() => void) | null = null;
+
+  const fail = (reason: string) => {
+    if (failure) return;
+    failure = reason;
+    settleFinish?.();
+  };
+
+  const currentText = () =>
+    [committed, partial].filter((part) => part.trim().length > 0).join(" ");
+
+  const sendSamples = (samples: Int16Array, commit: boolean): boolean => {
+    if (!socket || socket.readyState !== WebSocket.OPEN) return false;
+    if (commit) {
+      commitsSent += 1;
+      samplesSinceCommit = 0;
+    }
+    socket.send(
+      JSON.stringify({
+        message_type: "input_audio_chunk",
+        audio_base_64: samples.length > 0 ? toBase64(samples) : "",
+        commit,
+        sample_rate: LIVE_SAMPLE_RATE,
+      }),
+    );
+    return true;
+  };
+
+  const flushOutbox = (commit: boolean) => {
+    if (outboxSamples === 0 && !commit) return;
+    const merged = new Int16Array(outboxSamples);
+    let offset = 0;
+    for (const part of outbox) {
+      merged.set(part, offset);
+      offset += part.length;
+    }
+    outbox = [];
+    outboxSamples = 0;
+    sendSamples(merged, commit);
+  };
+
+  const enqueue = (samples: Int16Array, rms: number) => {
+    if (socket && socket.readyState === WebSocket.OPEN) {
+      outbox.push(samples);
+      outboxSamples += samples.length;
+      samplesSinceCommit += samples.length;
+      silentSamples =
+        rms < LIVE_SILENCE_RMS ? silentSamples + samples.length : 0;
+      const pause =
+        silentSamples >= LIVE_PAUSE_COMMIT_SILENCE_SAMPLES &&
+        samplesSinceCommit >= LIVE_PAUSE_COMMIT_MIN_SAMPLES;
+      if (pause) {
+        silentSamples = 0;
+        flushOutbox(true);
+      } else if (outboxSamples >= LIVE_SEND_SAMPLES) {
+        flushOutbox(false);
+      }
+      return;
+    }
+    pending.push(samples);
+    pendingSamples += samples.length;
+    if (pendingSamples > LIVE_MAX_BUFFERED_SAMPLES) fail("buffer overflow");
+  };
+
+  const connect = (token: string, modelId: string, language: string) =>
+    new Promise<void>((resolve, reject) => {
+      const params = new URLSearchParams({
+        model_id: modelId,
+        token,
+        audio_format: "pcm_16000",
+        commit_strategy: "manual",
+        language_code: language,
+      });
+      const next = new WebSocket(`${LIVE_SOCKET_URL}?${params.toString()}`);
+      let started = false;
+      next.onmessage = (event) => {
+        let message: { message_type?: string; text?: string; error?: string };
+        try {
+          message = JSON.parse(String(event.data)) as typeof message;
+        } catch {
+          return;
+        }
+        const type = message.message_type ?? "";
+        if (type === "session_started") {
+          started = true;
+          resolve();
+          return;
+        }
+        if (type === "partial_transcript") {
+          partial = message.text ?? "";
+          options.onText(currentText());
+          return;
+        }
+        if (type.startsWith("committed_transcript")) {
+          const text = (message.text ?? "").trim();
+          if (text) committed = committed ? `${committed} ${text}` : text;
+          partial = "";
+          commitsReceived += 1;
+          options.onText(currentText());
+          if (finishing && commitsReceived >= commitsSent) settleFinish?.();
+          return;
+        }
+        if (type.includes("error") || message.error) {
+          const reason = `${type || "error"}: ${message.error ?? ""}`.slice(
+            0,
+            120,
+          );
+          if (!started) reject(new Error(reason));
+          else fail(reason);
+        }
+      };
+      next.onerror = () => {
+        if (!started) reject(new Error("socket error"));
+        else fail("socket error");
+      };
+      next.onclose = (event) => {
+        if (!started) reject(new Error(`closed ${event.code}`));
+        else if (
+          !finishing ||
+          commitsSent === 0 ||
+          commitsReceived < commitsSent
+        ) {
+          fail(`closed ${event.code}`);
+        }
+      };
+      socket = next;
+    });
+
+  void (async () => {
+    try {
+      const token = await fetchToken(controller.signal);
+      const models = token.models?.length ? token.models : ["scribe_v2_realtime"];
+      let lastError: unknown = null;
+      for (const [index, modelId] of models.entries()) {
+        if (controller.signal.aborted) return;
+        try {
+          const fresh =
+            index === 0 ? token : await fetchToken(controller.signal);
+          await connect(fresh.token!, modelId, token.language ?? "ru");
+          model = modelId;
+          lastError = null;
+          break;
+        } catch (error) {
+          lastError = error;
+          socket?.close();
+          socket = null;
+        }
+      }
+      if (lastError) throw lastError;
+      if (controller.signal.aborted) {
+        socket?.close();
+        return;
+      }
+      const buffered = pending;
+      pending = [];
+      pendingSamples = 0;
+      for (const part of buffered) enqueue(part, 1);
+      if (finishing) {
+        flushOutbox(true);
+      }
+    } catch (error) {
+      fail(error instanceof Error ? error.message : String(error));
+    }
+  })();
+
+  return {
+    push(samples, sampleRate) {
+      if (failure || finishing || controller.signal.aborted) return;
+      let energy = 0;
+      for (let index = 0; index < samples.length; index += 1) {
+        energy += samples[index]! * samples[index]!;
+      }
+      const rms = samples.length > 0 ? Math.sqrt(energy / samples.length) : 0;
+      enqueue(downsample(samples, sampleRate), rms);
+    },
+    finish(timeoutMs) {
+      finishing = true;
+      return new Promise<LiveResult>((resolve) => {
+        let done = false;
+        let confirmed = false;
+        const timer = setTimeout(complete, timeoutMs);
+        function complete() {
+          if (done) return;
+          done = true;
+          clearTimeout(timer);
+          settleFinish = null;
+          const text = committed.trim();
+          socket?.close();
+          controller.abort();
+          if (failure) resolve({ ok: false, reason: failure });
+          else if (!model) resolve({ ok: false, reason: "not connected" });
+          else if (!confirmed) {
+            resolve({ ok: false, reason: "final not confirmed" });
+          } else if (!text) resolve({ ok: false, reason: "empty" });
+          else resolve({ ok: true, text, model });
+        }
+        settleFinish = () => {
+          confirmed =
+            !failure && commitsSent > 0 && commitsReceived >= commitsSent;
+          complete();
+        };
+        if (failure) {
+          complete();
+          return;
+        }
+        if (socket && socket.readyState === WebSocket.OPEN && model) {
+          flushOutbox(true);
+        }
+      });
+    },
+    abort() {
+      finishing = true;
+      fail("aborted");
+      controller.abort();
+      socket?.close();
+    },
+  };
+}
