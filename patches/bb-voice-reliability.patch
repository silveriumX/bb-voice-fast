+class FakeSocket {
+  static OPEN = 1;
+  static last: FakeSocket | undefined;
+  readyState = 0;
+  sent: { commit: boolean; audio: string }[] = [];
+  onmessage: ((event: { data: string }) => void) | null = null;
+  onerror: (() => void) | null = null;
+  onclose: ((event: { code: number }) => void) | null = null;
+  constructor(public url: string) {
+    FakeSocket.last = this;
+    queueMicrotask(() => {
+      this.readyState = 1;
+      this.emit({ message_type: "session_started" });
+    });
+  }
+  send(data: string) {
+    const parsed = JSON.parse(data) as { commit: boolean; audio_base_64: string };
+    this.sent.push({ commit: parsed.commit, audio: parsed.audio_base_64 });
+  }
+  close() {
+    this.readyState = 3;
+  }
+  emit(message: Record<string, unknown>) {
+    this.onmessage?.({ data: JSON.stringify(message) });
+  }
+  commits() {
+    return this.sent.filter((entry) => entry.commit).length;
+  }
